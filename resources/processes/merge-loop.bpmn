          <dc:Bounds x="1394" y="375" width="88" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_mark-merged" bpmnElement="mark-merged">
