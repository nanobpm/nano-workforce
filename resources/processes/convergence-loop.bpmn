      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-fixci-live" bpmnElement="gw-fixci-live" isMarkerVisible="true">
        <dc:Bounds x="2916" y="495" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2871" y="550" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-status" bpmnElement="gw-status" isMarkerVisible="true">
        <dc:Bounds x="966" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="965" y="316" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-adv-due" bpmnElement="gw-adv-due" isMarkerVisible="true">
