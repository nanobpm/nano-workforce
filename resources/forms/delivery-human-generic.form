{
  "id": "delivery-human-generic",
  "schemaVersion": 18,
  "type": "default",
  "components": [
    {
      "type": "text",
      "label": "Now do this",
      "text": "This task's instruction is shown in the Decision context above."
    },
    {
      "type": "textfield",
      "key": "value",
      "label": "Emitted value (only when this step emits exactly one value-emitting (non-artifact) fact)",
      "description": "The typed value this step hands forward to its downstream dependents. It is applied ONLY when the step emits exactly one value-emitting (non-artifact) fact: leave it blank for a step that emits no value-emitting fact, and for a step emitting more than one value-emitting fact any entry here is discarded (a single value cannot satisfy several distinct facts). An artifact-emitting fact is captured separately and does not count toward this boundary, so a step emitting one value plus one artifact still applies this field."
    },
    {
      "type": "textarea",
      "key": "note",
      "label": "Note (optional)",
      "description": "Optional operator note."
    }
  ]
}
