{
  "id": "delivery-human-generic",
  "schemaVersion": 18,
  "type": "default",
  "components": [
    {
      "type": "text",
      "label": "Now do this",
      "text": "This task's instruction is shown in the Decision context above."
    },
    {
      "type": "textfield",
      "key": "value",
      "label": "Emitted value (the single value this step hands forward)",
      "description": "The typed value this task hands forward to its downstream dependents. For a human step it is the one value-emitting fact; for a timed-out wait gate it is the awaited value — which may be an artifact handle (entered here and mapped onto the gate's resolved value). Leave it blank when the step emits nothing. One field carries at most one value: a human step that must emit several facts is refused at authoring time, and a wait gate with more than one emit leaves this field inert — re-run the step to produce those facts."
    },
    {
      "type": "textarea",
      "key": "note",
      "label": "Note (optional)",
      "description": "Optional operator note."
    }
  ]
}
