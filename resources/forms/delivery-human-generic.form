{
  "id": "delivery-human-generic",
  "schemaVersion": 18,
  "type": "default",
  "components": [
    {
      "type": "text",
      "label": "Now do this",
      "text": "This task's instruction is shown in the Decision context above."
    },
    {
      "type": "select",
      "key": "decision",
      "label": "Resolution",
      "defaultValue": "continue",
      "description": "Escalation of an agent or connector step: Retry re-runs the step (the note below is passed to the agent as guidance). Continue completes it as resolved \u2014 supply the emitted value if the step was finished out of band.",
      "values": [
        {
          "label": "Continue",
          "value": "continue"
        },
        {
          "label": "Retry this step",
          "value": "retry"
        }
      ]
    },
    {
      "type": "textfield",
      "key": "value",
      "label": "Emitted value (only if this step emits a fact)",
      "description": "The typed value this step hands forward to its downstream dependents. Leave blank for a click-done step that emits nothing."
    },
    {
      "type": "textarea",
      "key": "note",
      "label": "Note (optional)",
      "description": "Optional. On Retry, passed to the agent as guidance for the next attempt."
    }
  ]
}
