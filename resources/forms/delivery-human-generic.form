{
  "id": "delivery-human-generic",
  "schemaVersion": 18,
  "type": "default",
  "components": [
    {
      "type": "text",
      "label": "Now do this",
      "text": "This task's instruction is shown in the Decision context above."
    },
    {
      "type": "textfield",
      "key": "value",
      "label": "Emitted value (the single value-emitting (non-artifact) fact this step hands forward)",
      "description": "The typed value this step hands forward to its downstream dependents. It captures a single value-emitting (non-artifact) fact — leave it blank for a step that emits no value-emitting fact. A step that publishes an artifact uses a dedicated form with a resolved-artifact field instead, and a step that must emit several facts is rejected at authoring time, so this field never has to carry more than one value."
    },
    {
      "type": "textarea",
      "key": "note",
      "label": "Note (optional)",
      "description": "Optional operator note."
    }
  ]
}
