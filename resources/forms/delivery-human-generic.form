{
  "id": "delivery-human-generic",
  "schemaVersion": 18,
  "type": "default",
  "components": [
    {
      "type": "textarea",
      "key": "prompt",
      "label": "Now do this",
      "description": "The scheduled human step this delivery graph is waiting on. Its full instruction is shown in the Decision context above.",
      "readonly": true
    },
    {
      "type": "textfield",
      "key": "value",
      "label": "Emitted value (only if this step emits a fact)",
      "description": "The typed value this step hands forward to its downstream dependents. Leave blank for a click-done step that emits nothing — an emit node's value is validated server-side against its declared fact."
    },
    {
      "type": "textarea",
      "key": "note",
      "label": "Note (optional)"
    }
  ]
}
