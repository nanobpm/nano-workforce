{
  "id": "delivery-escalation",
  "schemaVersion": 18,
  "type": "default",
  "components": [
    {
      "type": "text",
      "label": "Now do this",
      "text": "This task's instruction is shown in the Decision context above."
    },
    {
      "type": "select",
      "key": "decision",
      "label": "Resolution",
      "defaultValue": "continue",
      "description": "Escalation of an agent or connector step: Retry re-runs the step (for an agent step, the note below is passed to the agent as guidance; a connector step ignores the note). Continue completes it as resolved — supply the emitted value if the step was finished out of band.",
      "values": [
        {
          "label": "Continue",
          "value": "continue"
        },
        {
          "label": "Retry this step",
          "value": "retry"
        }
      ]
    },
    {
      "type": "textfield",
      "key": "value",
      "label": "Emitted value (only when this step emits exactly one fact)",
      "description": "The typed value this step hands forward to its downstream dependents, applied on Continue. It is applied ONLY when the step emits exactly one fact AND that fact is actually consumed downstream: leave it blank for a click-done step that emits nothing (or whose sole emit is routing-only/unconsumed, where any entry is discarded — nothing reads it), and for a step emitting more than one fact any entry here is discarded (a single value cannot satisfy several distinct facts) — choose \"Retry this step\" to actually produce those facts."
    },
    {
      "type": "textarea",
      "key": "escalationNote",
      "label": "Note (optional)",
      "description": "Optional. On Retry of an AGENT step, passed to the agent as guidance for the next attempt. A connector-step retry ignores this note."
    }
  ]
}
