{
  "schemaVersion": "1.0",
  "title": "Tasks",
  "nodes": [
    {
      "type": "nav",
      "id": "nav",
      "props": {
        "variant": "bar",
        "title": "Nano Workforce",
        "items": [
          {
            "label": "Overview",
            "page": "overview"
          },
          {
            "label": "Lineage",
            "page": "lineage"
          },
          {
            "label": "Convergence",
            "page": "home"
          },
          {
            "label": "Epics",
            "page": "epic"
          },
          {
            "label": "Feature",
            "page": "feature"
          },
          {
            "label": "Tasks",
            "page": "tasks"
          },
          {
            "label": "Cockpit",
            "page": "cockpit"
          },
          {
            "label": "Board",
            "page": "board"
          }
        ]
      }
    },
    {
      "type": "text",
      "id": "title",
      "props": {
        "text": "Tasks",
        "variant": "heading"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "props": {
        "text": "Open native user-task escalations awaiting a human decision — across feature runs, epics, and PR review loops. Each row parks a process on your decision; submit one and the process resumes on the same canonical path Urban's task inbox uses. Rows disappear once completed (here, via the inbox, or out-of-band).",
        "variant": "sub"
      }
    },
    {
      "type": "dataGrid",
      "id": "feature-escalations",
      "props": {
        "title": "Feature escalations",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
                "feature-escalation"
              ]
            }
          ],
          "orderBy": {
            "field": "updated_at",
            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "subject_url",
            "header": "Issue"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Escalation question"
            }
          ]
        },
        "refreshMs": 5000
      }
    },
    {
      "type": "dataGrid",
      "id": "plan-reviews",
      "props": {
        "title": "Plan-review decisions",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
                "plan-review-decision"
              ]
            }
          ],
          "orderBy": {
            "field": "updated_at",
            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "question",
            "header": "Findings"
          },
          {
            "field": "subject_url",
            "header": "Issue"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Review findings"
            }
          ]
        },
        "refreshMs": 5000
      }
    },
    {
      "type": "dataGrid",
      "id": "trial-merges",
      "props": {
        "title": "Trial-merge decisions",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
                "trial-merge-decision"
              ]
            }
          ],
          "orderBy": {
            "field": "updated_at",
            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "question",
            "header": "Trial merge"
          },
          {
            "field": "subject_url",
            "header": "Issue"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Trial merge"
            }
          ]
        },
        "refreshMs": 5000
      }
    },
    {
      "type": "dataGrid",
      "id": "pr-reviews",
      "props": {
        "title": "PR escalations",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
                "wait-answer",
                "wait-merge-answer"
              ]
            }
          ],
          "orderBy": {
            "field": "updated_at",
            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "kind_label",
            "header": "Stage"
          },
          {
            "field": "subject_url",
            "header": "PR link"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Escalation question"
            }
          ],
          "form": {
            "showWhenField": "user_task_key",
            "title": "Answer escalation",
            "promptField": "question",
            "inputKey": "answer",
            "inputLabel": "Your answer",
            "submitLabel": "Answer & resume",
            "action": {
              "path": "/app/api/actions/complete-user-task",
              "successLabel": "Answered — the loop will resume",
              "body": {
                "userTaskKey": "{{row.user_task_key}}",
                "variables": {
                  "answer": "{{form.answer}}"
                }
              }
            }
          }
        },
        "refreshMs": 5000
      }
    },
    {
      "type": "dataGrid",
      "id": "blocked-runs",
      "props": {
        "title": "Blocked feature runs",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
