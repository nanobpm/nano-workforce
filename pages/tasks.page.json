{
  "schemaVersion": "1.0",
  "title": "Tasks",
  "nodes": [
    {
      "type": "nav",
      "id": "nav",
      "props": {
        "variant": "bar",
        "title": "Nano Workforce",
        "items": [
          {
            "label": "Overview",
            "page": "overview"
          },
          {
            "label": "Lineage",
            "page": "lineage"
          },
          {
            "label": "Convergence",
            "page": "home"
          },
          {
            "label": "Epics",
            "page": "epic"
          },
          {
            "label": "Feature",
            "page": "feature"
          },
          {
            "label": "Tasks",
            "page": "tasks",
            "badge": {
              "source": "app",
              "table": "user_tasks",
              "filter": [],
              "tone": "danger",
              "refreshMs": 5000,
              "hideWhenZero": true
            }
          },
          {
            "label": "Cockpit",
            "page": "cockpit"
          },
          {
            "label": "Board",
            "page": "board"
          },
          {
            "label": "Velocity",
            "page": "velocity"
          }
        ],
        "sticky": true
      }
    },
    {
      "type": "text",
      "id": "title",
      "props": {
        "text": "Tasks",
        "variant": "heading"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "props": {
        "text": "Open native user-task escalations awaiting a human decision — across feature runs, epics, and PR review loops. Each row parks a process on your decision; submit one and the process resumes on the same canonical path Urban's task inbox uses. Rows disappear once completed (here, via the inbox, or out-of-band).",
        "variant": "sub"
      }
    },
    {
      "type": "dataGrid",
      "id": "feature-escalations",
      "props": {
        "title": "Feature escalations",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
                "feature-escalation"
              ]
            }
          ],
          "orderBy": {
            "field": "updated_at",
            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "subject_url",
            "header": "Issue"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Escalation question"
            }
          ],
          "form": {
            "showWhenField": "user_task_key",
            "title": "Answer escalation",
            "promptField": "question",
            "submitLabel": "Submit decision",
            "fields": [
              {
                "inputKey": "resolution",
                "type": "select",
                "inputLabel": "Resolution",
                "options": [
                  { "value": "answer", "label": "Answer — re-dispatch the task with this guidance" },
                  { "value": "abandon", "label": "Abandon — give up on this task" }
                ]
              },
              {
                "inputKey": "answer",
                "type": "textarea",
                "inputLabel": "Answer / guidance for the implementation agent",
                "conditional": {
                  "hide": "=resolution != \"answer\""
                }
              }
            ],
            "action": {
              "path": "/app/api/actions/complete-user-task",
              "successLabel": "Decision submitted — the process will continue",
              "body": {
                "userTaskKey": "{{row.user_task_key}}",
                "variables": "{{form}}"
              }
            }
          }
        },
        "refreshMs": 5000
      }
    },
    {
      "type": "dataGrid",
      "id": "plan-reviews",
      "props": {
        "title": "Plan-review decisions",
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "user_tasks",
          "filter": [
            {
              "field": "element_id",
              "in": [
                "plan-review-decision"
              ]
            }
          ],
          "orderBy": {
            "field": "updated_at",
            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "question",
            "header": "Findings"
          },
          {
            "field": "subject_url",
            "header": "Issue"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Review findings"
            }
          ],
          "form": {
            "showWhenField": "user_task_key",
            "title": "Review the plan",
            "promptField": "question",
            "submitLabel": "Submit decision",
            "fields": [
              {
                "inputKey": "directive",
                "type": "select",
                "inputLabel": "Directive",
                "options": [
                  { "value": "proceed", "label": "Proceed — dispatch the current plan as-is" },
                  { "value": "revise", "label": "Revise — send the plan back to the planner" }
                ]
              },
              {
                "inputKey": "notes",
                "type": "textarea",
                "inputLabel": "Revision guidance for the planner",
                "conditional": {
                  "hide": "=directive != \"revise\""
                }
              }
            ],
            "action": {
              "path": "/app/api/actions/complete-user-task",
              "successLabel": "Decision recorded",
              "body": {
                "userTaskKey": "{{row.user_task_key}}",
                "variables": "{{form}}"
              }
            }
          }
        },
        "refreshMs": 5000
      }
    },
    {
      "type": "dataGrid",
      "id": "trial-merges",
      "props": {
        "title": "Trial-merge decisions",
