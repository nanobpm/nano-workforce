            "dir": "desc"
          }
        },
        "columns": [
          {
            "field": "subject_title",
            "template": "{{subject_title}}",
            "header": "Item",
            "subtitleField": "subject_key",
            "truncate": true,
            "linkField": "subject_url"
          },
          {
            "field": "question",
            "header": "Disposition"
          },
          {
            "field": "subject_url",
            "header": "Issue"
          },
          {
            "field": "process_key",
            "header": "Process",
            "link": {
              "kind": "processExplorer",
              "keyField": "process_key"
            }
          },
          {
            "field": "updated_at",
            "header": "Updated",
            "format": "datetime"
          }
        ],
        "rowKey": "user_task_key",
        "detail": {
          "linkField": "subject_url",
          "fields": [
            {
              "field": "question",
              "label": "Disposition"
            }
          ]
        },
        "refreshMs": 5000
      }
    }
  ]
}