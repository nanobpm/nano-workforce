{
  "schemaVersion": "1.0",
  "title": "Epic Coordination",
  "nodes": [
    {
      "type": "nav",
      "id": "nav",
      "props": {
        "variant": "bar",
        "sticky": true,
        "title": "Nano Workforce",
        "items": [
          { "label": "Convergence", "page": "home" },
          { "label": "Epics", "page": "epic" },
          { "label": "Cockpit", "page": "cockpit" }
        ]
      }
    },
    {
      "type": "text",
      "id": "title",
      "props": { "text": "Epic Coordination", "variant": "heading" }
    },
    {
      "type": "text",
      "id": "subtitle",
      "props": {
        "text": "Hand an issue to the fleet to plan and implement it, then open an epic to track its review trace, wave state, merge-exclusion graph, coordination notes, and trial-merge gate results.",
        "variant": "sub"
      }
    },
    {
      "type": "actionForm",
      "id": "plan-submit",
      "props": {
        "title": "Hand an issue to the fleet",
        "submitLabel": "Plan & implement",
        "action": { "path": "/app/api/actions/start/plan-fanout", "body": "{{form}}" },
        "fields": [
          { "key": "issue", "label": "owner/repo#123 or a GitHub issue URL", "type": "text" },
          { "key": "baseBranch", "label": "Base branch (blank = repo default; e.g. epic/agent-protocol to land the whole epic on an integration branch)", "type": "text" }
        ]
      }
    },
    {
      "type": "dataGrid",
      "id": "epic-plans",
      "props": {
        "title": "Epics",
        "rowKey": "plan_key",
        "refreshMs": 5000,
        "data": {
          "kind": "datasource",
          "source": "app",
          "table": "plans",
          "orderBy": { "field": "updated_at", "dir": "desc" },
          "filter": [{ "field": "status", "in": ["planning", "dispatched"] }]
        },
        "tabs": [
          {
            "label": "Active",
            "filter": [{ "field": "status", "in": ["planning", "dispatched"] }]
          },
          {
            "label": "History",
            "filter": [{ "field": "status", "in": ["done", "failed", "abandoned"] }]
          },
          { "label": "All", "filter": [] }
        ],
        "columns": [
          { "field": "plan_key", "header": "Epic", "link": { "kind": "page", "page": "epic-detail", "keyField": "plan_key" } },
          { "field": "status", "header": "Status", "link": { "kind": "processExplorer", "keyField": "process_key" } },
          { "field": "wave_label", "header": "Wave" },
          { "field": "task_count", "header": "Tasks" },
          { "field": "open_plan_findings", "header": "Attention", "badge": { "tone": "danger", "label": "!" } },
          { "field": "issue_number", "header": "Issue", "linkField": "issue_url" },
          { "field": "updated_at", "header": "Updated" }
        ]
      }
    }
  ]
}
